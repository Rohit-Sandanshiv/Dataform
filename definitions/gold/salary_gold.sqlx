config {
    type: "table",
    schema : "gold"
}

SELECT
  *, 
  ABS(CAST(SUBSTR(TOTAL_LEVEL_SALARY, 1, length(CTE.TOTAL_LEVEL_SALARY) - 1) AS INT64) - CAST(SUBSTR(AVG_SALARY, 1, length(AVG_SALARY) - 1) AS INT64) * EMPLOYEE_COUNT) AS STABILITY
FROM ${ref("salary_silver")} ORDER BY STABILITY LIMIT 3